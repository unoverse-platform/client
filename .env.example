# ── Required in practice ────────────────────────────────────────────────────
# Your universe. Substituted into the <script src> in index.html.
# Default: http://localhost:4105
VITE_UNOVERSE_URL=https://api.your-domain.com

# Which app the assistant loads, always "<org>/<app>". Substituted into data-app.
# Default: demo/demo-chat-layout
VITE_UNOVERSE_APP=your-org/your-app

# ── Only if your app needs a login ──────────────────────────────────────────
# Your own identity provider. Your universe must be configured to trust this
# same issuer and audience, or it will reject the tokens you send.
# Leave unset for a public app: visitors get a guest identity and no login.
VITE_AUTH_ISSUER=https://your-tenant.auth0.com
VITE_AUTH_CLIENT_ID=your-client-id
VITE_AUTH_AUDIENCE=gravity-api
